{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "receitaai-mvp",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}